# Copy this file to .env for local development or place .env next to the built
# launcher executable for a private installed build. Do not commit real values.

SPOTIFY_CLIENT_ID=YOUR_SPOTIFY_CLIENT_ID_HERE
SPOTIFY_CLIENT_SECRET=YOUR_SPOTIFY_CLIENT_SECRET_HERE
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback

CURSEFORGE_API_KEY=YOUR_CURSEFORGE_API_KEY_HERE

# Account authentication app registrations.
# Microsoft: register a public desktop/native app. The embedded flow uses
# https://login.microsoftonline.com/common/oauth2/nativeclient by default; add
# http://localhost as an optional fallback redirect for system-browser capture.
NOTG_MICROSOFT_CLIENT_ID=YOUR_MICROSOFT_APP_CLIENT_ID_HERE
NOTG_MICROSOFT_REDIRECT_URI=https://login.microsoftonline.com/common/oauth2/nativeclient

# Ely.by: public clients such as notg-launcher do not require a client secret.
# Use the same redirect URI here and in Ely.by.
NOTG_ELY_CLIENT_ID=YOUR_ELY_APP_CLIENT_ID_HERE
NOTG_ELY_REDIRECT_URI=http://localhost:8765/callback
